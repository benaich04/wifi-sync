%load('../data/wave_clean.mat'); % clean waveform
%load('../data/wave_noisy.mat');  % trying with noisy signal 5dB
%load('../data/wave_cfo.mat');  % clean signal but with cfo 
load('../data/wave_3pkt.mat');  % clean signal, no cfo, 3 packets

addpath('../sync');

N  = length(rx);
s  = zeros(N,1);
a  = false(N,1);
pe = zeros(N,1);
pk = zeros(N,1);

sync_step(0, true);

for k = 1:N
    [s(k), a(k), pe(k), pk(k)] = sync_step(rx(k), false);

end

find(pe)
preamble_end
max(s)
find(a, 1)
max(pk(2200:2400))




